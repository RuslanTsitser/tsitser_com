---
import { site, nav } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="fixed top-0 w-full z-50 border-b border-[var(--border)]"
  style="background: var(--nav-bg); backdrop-filter: blur(12px);"
>
  <nav class="max-w-[var(--spacing-container)] mx-auto px-5 md:px-10 py-5 flex justify-between items-center">
    <a href="#home" class="font-serif text-xl md:text-2xl font-bold text-[var(--text)]">{site.name}</a>
    <div class="hidden md:flex items-center gap-8">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[var(--text-muted)] hover:text-[var(--text)] font-medium transition-colors"
          >
            {item.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
    <div class="flex md:hidden items-center gap-2">
      <ThemeToggle />
      <button type="button" id="mobile-menu-btn" class="p-2 text-[var(--text)]" aria-label="Menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--border)] px-5 pb-5">
    {
      nav.map((item) => (
        <a href={item.href} class="block py-3 text-[var(--text-muted)] hover:text-[var(--text)] font-medium">
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu?.classList.add('hidden')));
</script>
