---
import { site } from '../data/site';
---

<section
  id="home"
  class="max-w-[var(--spacing-container)] mx-auto px-5 md:px-10 pt-28 md:pt-32 pb-16 md:pb-24"
>
  <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-6 min-h-[70vh]">
    <div class="w-full lg:w-[48%] z-10">
      <h1 class="font-serif text-4xl md:text-5xl lg:text-[3.25rem] leading-[1.15] font-bold text-[var(--text)] mb-4">
        {site.heroTitle}
      </h1>
      <p class="text-lg text-[var(--text-muted)] mb-8 max-w-md">{site.heroSubtitle}</p>
      <div class="flex flex-wrap gap-4">
        <a href="#contact" class="btn-primary">Get Started Now</a>
        <a href="#projects" class="btn-secondary">View Features</a>
      </div>
    </div>
    <div class="w-full lg:w-[52%] relative min-h-[320px] md:min-h-[420px]">
      <div
        class="absolute inset-y-0 left-0 w-1/3 z-10 pointer-events-none hidden lg:block"
        style={`background: var(--hero-fade);`}
      >
      </div>
      <img
        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=900&q=80"
        alt="Developer at work"
        class="w-full h-full min-h-[320px] md:min-h-[420px] object-cover rounded-2xl lg:rounded-none lg:rounded-r-2xl"
        loading="eager"
      />
    </div>
  </div>
</section>
