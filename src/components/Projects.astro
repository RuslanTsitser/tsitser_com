---
import { projects } from '../data/site';
import ProjectVisual from './ProjectVisual.astro';
---

<section class="py-[var(--spacing-section)] px-5 md:px-10" id="projects">
  <div class="max-w-[var(--spacing-container)] mx-auto">
    <h2 class="section-title mb-14 md:mb-20">Projects</h2>
    <div class="space-y-10 md:space-y-14">
      {
        projects.map((project) => (
          <article class="card-surface p-6 md:p-8 lg:p-10">
            <div
              class:list={[
                'flex flex-col gap-8 lg:gap-12 items-center',
                project.imageFirst ? 'lg:flex-row-reverse' : 'lg:flex-row',
              ]}
            >
              <div class="w-full lg:w-1/2 space-y-5">
                <h3 class="font-serif text-2xl md:text-3xl font-bold">{project.title}</h3>
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
                <p class="text-[var(--text-muted)] leading-relaxed">{project.description}</p>
                <div class="flex flex-wrap items-center gap-4 pt-2">
                  {project.primaryHref ? (
                    <a href={project.primaryHref} target="_blank" rel="noopener noreferrer" class="btn-primary text-sm py-3 px-6">
                      {project.primaryLabel}
                    </a>
                  ) : (
                    <span class="tag-pill">{project.primaryLabel}</span>
                  )}
                  {project.secondaryLabel && project.primaryHref && (
                    <a
                      href={project.primaryHref}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--terra)] font-semibold flex items-center gap-1 hover:underline"
                    >
                      {project.secondaryLabel}
                      <span class="material-symbols-outlined text-lg">arrow_forward</span>
                    </a>
                  )}
                </div>
              </div>
              <div class="w-full lg:w-1/2">
                <ProjectVisual accent={project.accent} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
