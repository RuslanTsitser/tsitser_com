---
import { getProjects } from '../lib/projects';
import { projectsSection } from '../data/site';
import ProjectVisual from './ProjectVisual.astro';

const projects = await getProjects();
---

<section class="py-[var(--spacing-section)] px-5 md:px-10" id="projects">
  <div class="max-w-[var(--spacing-container)] mx-auto">
    <h2 class="section-title mb-4">{projectsSection.title}</h2>
    <p class="text-center text-[var(--text-muted)] max-w-2xl mx-auto mb-14 md:mb-20">{projectsSection.description}</p>
    <div class="space-y-10 md:space-y-14">
      {
        projects.map((project) => (
          <article class="card-surface p-6 md:p-8 lg:p-10">
            <div
              class:list={[
                'flex flex-col gap-8 lg:gap-12 items-center',
                project.imageFirst ? 'lg:flex-row-reverse' : 'lg:flex-row',
              ]}
            >
              <div class="w-full lg:w-1/2 space-y-5">
                <div class="flex flex-wrap items-center gap-3">
                  <h3 class="font-serif text-2xl md:text-3xl font-bold">{project.title}</h3>
                  <span class="tag-pill">Personal project</span>
                </div>
                {project.subtitle && (
                  <p class="text-sm font-semibold uppercase tracking-wider text-[var(--terra)]">{project.subtitle}</p>
                )}
                <div class="flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="tag-pill">{tag}</span>
                  ))}
                </div>
                <p class="text-[var(--text-muted)] leading-relaxed">{project.description}</p>
                <div class="flex flex-wrap items-center gap-4 pt-2">
                  <a
                    href={project.appStoreUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary text-sm py-3 px-6"
                  >
                    App Store
                  </a>
                  {
                    project.playStoreUrl && (
                      <a
                        href={project.playStoreUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-secondary text-sm py-3 px-6"
                      >
                        Google Play
                      </a>
                    )
                  }
                </div>
              </div>
              <div class="w-full lg:w-1/2">
                <ProjectVisual title={project.title} subtitle={project.subtitle} iconUrl={project.iconUrl} />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
