---
import { site, social } from '../data/site';
---

<footer class="py-16 md:py-20 px-5 border-t border-[var(--border)]">
  <div class="max-w-[var(--spacing-container)] mx-auto text-center">
    <p class="font-serif text-xl md:text-2xl font-bold mb-2">{site.name}</p>
    <p class="text-sm text-[var(--text-muted)] mb-8">
      Designed with care · © {new Date().getFullYear()} {site.name}
    </p>
    <div class="flex justify-center gap-6">
      {
        social.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-muted)] hover:text-[var(--green)] transition-colors"
            aria-label={item.label}
          >
            <span class="material-symbols-outlined text-2xl">{item.icon}</span>
          </a>
        ))
      }
    </div>
  </div>
</footer>
