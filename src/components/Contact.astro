---
import { site } from '../data/site';
---

<section class="py-[var(--spacing-section-gap)] relative" id="contact">
  <div class="max-w-[var(--spacing-container-max)] mx-auto px-[var(--spacing-margin-mobile)]">
    <div class="flex flex-col md:flex-row gap-16 md:gap-24">
      <div class="w-full md:w-1/2">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-12 h-0.5 bg-primary-container"></span>
          <p class="text-primary-container font-mono-label uppercase tracking-widest">Contact</p>
        </div>
        <h2 class="font-headline text-4xl md:text-5xl font-extrabold mb-12">
          Have a project?<br />Let's talk!
        </h2>
        <div class="space-y-6">
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 text-on-surface-variant hover:text-primary-container transition-colors"
          >
            <span class="material-symbols-outlined text-primary-container">work</span>
            <span>LinkedIn — ruslan-tsitser</span>
          </a>
          <a
            href={site.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 text-on-surface-variant hover:text-primary-container transition-colors"
          >
            <span class="material-symbols-outlined text-primary-container">code</span>
            <span>GitHub — RuslanTsitser</span>
          </a>
          <div class="flex items-center gap-4 text-on-surface-variant">
            <span class="material-symbols-outlined text-primary-container">location_on</span>
            <span>{site.location}</span>
          </div>
        </div>
      </div>
      <div class="w-full md:w-1/2">
        <form
          class="space-y-[var(--spacing-gutter)] glass-card p-8 rounded-xl"
          action={`https://www.linkedin.com/in/ruslan-tsitser/`}
          method="get"
          target="_blank"
          rel="noopener noreferrer"
        >
          <p class="text-on-surface-variant text-sm mb-2">
            Submit opens LinkedIn — the best way to reach me for new projects.
          </p>
          <div>
            <label class="block font-mono-label text-on-surface-variant mb-2 uppercase">Name</label>
            <input
              class="w-full bg-background border-b border-[var(--card-border)] focus:border-primary-container focus:ring-0 text-on-surface transition-colors py-3 px-0 outline-none"
              type="text"
              name="name"
              required
            />
          </div>
          <div>
            <label class="block font-mono-label text-on-surface-variant mb-2 uppercase">Email</label>
            <input
              class="w-full bg-background border-b border-[var(--card-border)] focus:border-primary-container focus:ring-0 text-on-surface transition-colors py-3 px-0 outline-none"
              type="email"
              name="email"
              required
            />
          </div>
          <div>
            <label class="block font-mono-label text-on-surface-variant mb-2 uppercase">Message</label>
            <textarea
              class="w-full bg-background border-b border-[var(--card-border)] focus:border-primary-container focus:ring-0 text-on-surface transition-colors py-3 px-0 resize-none outline-none"
              rows="4"
              name="message"
              required></textarea>
          </div>
          <button
            type="submit"
            class="w-full md:w-auto bg-primary-container text-on-primary-container px-12 py-4 rounded-lg font-bold hover:scale-105 active:scale-95 transition-transform mt-4"
          >
            Connect on LinkedIn
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
