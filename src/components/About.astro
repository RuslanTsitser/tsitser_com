---
import { about } from '../data/site';
---

<section class="py-[var(--spacing-section)] px-5 md:px-10" id="about">
  <div class="max-w-[var(--spacing-container)] mx-auto">
    <div class="card-surface p-6 md:p-10 lg:p-12">
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-12">
        <div class="w-full lg:w-[280px] shrink-0">
          <img
            src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=560&q=80"
            alt="Ruslan Tsitser"
            class="w-full aspect-square object-cover rounded-xl"
            loading="lazy"
          />
        </div>
        <div class="flex-1">
          <h2 class="font-serif text-3xl md:text-4xl font-bold mb-2">About me</h2>
          <span class="tag-pill inline-block mb-6">{about.tag}</span>
          <p class="text-[var(--text-muted)] text-base md:text-lg leading-relaxed mb-10">{about.text}</p>
          <div class="grid grid-cols-3 gap-4 md:gap-8 pt-6 border-t border-[var(--border)]">
            {
              about.stats.map((stat) => (
                <div>
                  <p class="font-serif text-2xl md:text-3xl font-bold text-[var(--text)]">{stat.value}</p>
                  <p class="text-xs md:text-sm font-semibold uppercase tracking-wider text-[var(--text-muted)] mt-1">
                    {stat.label}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
