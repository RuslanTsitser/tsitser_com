---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TechStack from '../components/TechStack.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main class="relative pt-32 overflow-hidden" id="home">
    <div class="hero-wireframe w-[500px] h-[500px] -right-20 -top-20 hidden md:block"></div>
    <div class="hero-wireframe w-[300px] h-[300px] right-20 top-40 opacity-50 hidden md:block"></div>
    <Hero />
    <TechStack />
    <About />
    <Projects />
    <Contact />
    <Footer />
  </main>
</Layout>
